{
  "version": "10.0.0",
  "comment": "운영 taxonomy 단일 원천. v10은 위치 기반 Detect, 문맥·문체 분리, 보호 구간·잔존 패턴 검증을 추가한다. 번역 감사는 translation_audit.py와 references/translation-fidelity.md에 둔다.",
  "macro": [
    {"id": "A", "name": "번역투·영어 간섭", "severity": "P1",
     "keep": "원문이 번역문 인용일 때",
     "regex": ["에\\s*의해", "[를을]\\s*통해", "에\\s*다름\\s*아니", "그것은", "이들은", "그들은"]},
    {"id": "B", "name": "관공서·보도 상투구", "severity": "P1",
     "keep": "공문서 프로파일에서는 관례 표현 일부 허용",
     "profiles": {"official": "relaxed"},
     "regex": ["위해\\s*마련", "제고하", "추진할\\s*예정", "기대된다", "전망이다", "도모하", "의미가\\s*있다"]},
    {"id": "C", "name": "형식명사·명사화 종결", "severity": "P1",
     "keep": "강조용 ~것이다 1회 정도는 자연스러움",
     "regex": ["것이다[.\\s]", "라는\\s*점이다", "수\\s*있다는\\s*점"]},
    {"id": "D", "name": "문장부호 티", "severity": "P1",
     "keep": "부호가 의미를 갖는 장르(희곡·대사), 나열 리듬에 필요한 쉼표",
     "regex": ["—", "[가-힣]고,\\s", "[가-힣]며,\\s", "[가-힣]지만,\\s"]},
    {"id": "E", "name": "구조·서식 티", "severity": "P1",
     "keep": "내용이 진짜 목록일 때. 기술문서 프로파일에서는 목록·라벨 허용",
     "profiles": {"technical": "relaxed"},
     "regex": ["^\\s*[-*]\\s*\\*\\*[^*]+\\*\\*\\s*[:：]", "\\*\\*[^*]+[:：]\\*\\*"]},
    {"id": "F", "name": "리듬 단조", "severity": "P2",
     "keep": "의도된 수사적 반복이 원문 어투일 때",
     "computed": "rhythm", "regex": []},
    {"id": "G", "name": "상투·과장 수사", "severity": "P1",
     "keep": "근거가 바로 뒤따르는 강조",
     "regex": ["주목할\\s*만한", "혁신적", "획기적", "새로운\\s*지평", "괄목할", "눈부신"]},
    {"id": "H", "name": "수동·익명화", "severity": "P1",
     "keep": "주체가 정말 불특정한 사실 서술",
     "regex": ["평가받고\\s*있", "알려져\\s*있", "되어지", "여겨지고\\s*있"]},
    {"id": "I", "name": "이모지·장식", "severity": "P1",
     "keep": "SNS 프로파일에서 사용자가 명시적으로 유지를 요청할 때만 최소 유지",
     "profiles": {"sns": "relaxed"},
     "computed": "emoji", "regex": []},
    {"id": "J", "name": "접속 군더더기", "severity": "P2",
     "keep": "논리 전환이 실제로 필요한 곳",
     "regex": ["또한[,\\s]", "아울러", "한편[,\\s]", "뿐만\\s*아니라"]},
    {"id": "K", "name": "감정 표방 상투", "severity": "P1",
     "keep": "뒤 내용이 그 감정을 실제로 입증할 때",
     "regex": ["흥미로운\\s*(점|사실)", "주목할\\s*만한\\s*(점|사실)", "놀랍게도", "인상적인\\s*(점|부분)"]},
    {"id": "L", "name": "사고사슬·챗봇 흔적", "severity": "P0",
     "keep": "강의 스크립트 등 실제 진행 멘트",
     "regex": ["하나씩\\s*(살펴|짚어)", "단계별로\\s*(살펴|짚어)", "정리하면\\s*다음과\\s*같", "도움이\\s*되셨", "궁금한\\s*점이?\\s*있"]},
    {"id": "M", "name": "거짓 양보·헤지 스택", "severity": "P1",
     "keep": "실제 반론을 소개하고 반박하는 구조일 때",
     "regex": ["물론\\s.{0,30}(수\\s*있다|있지만)", "가능성도?\\s*배제할\\s*수\\s*없", "일\\s*수도\\s*있고", "어느\\s*정도는"]},
    {"id": "N", "name": "신선함·자기 라벨링 인플레", "severity": "P1",
     "keep": "없음",
     "regex": ["아무도\\s*말하지\\s*않", "모두가\\s*놓치", "핵심은\\s*단\\s*하나", "진짜\\s*문제는\\s*따로"]}
  ],
  "sunny": [
    {"no": 1, "name": "-적", "regex": "[가-힣]적[인으]", "baseline": 4.0, "keep": "개념어·전문어·대조('구조적 문제')"},
    {"no": 2, "name": "의 연쇄", "regex": "의\\s[가-힣]+의\\s", "baseline": 0.5, "keep": "소유·출처·고정 용어·중의성 해소"},
    {"no": 3, "name": "들", "regex": "[가-힣]들[이은을의과와도]", "baseline": 3.0, "keep": "실제 복수·분포·대조·강조"},
    {"no": 4, "name": "것", "regex": "것[이은을에]", "baseline": 8.0, "keep": "실제 대상·인용·필요한 추상"},
    {"no": 5, "name": "있는/있다는", "regex": "있다는", "baseline": 1.5, "keep": "존재·소유·진행 상태가 핵심"},
    {"no": 6, "name": "있었다", "regex": "있었다", "baseline": 1.0, "keep": "과거 존재·위치·소유·상태"},
    {"no": 7, "name": "어색한 있다", "regex": "에\\s있어|함에\\s*있어", "baseline": 0.3, "keep": "고정·기술 표현이라 단순화하면 뜻이 왜곡될 때"}
  ],
  "meaning_guards": {
    "comment": "preserve의 의미 동등성 경고 휴리스틱. 200자 초과 문서는 밀도 차가 tolerance를 넘으면 경고, binary_max_chars 이하 짧은 텍스트는 표지 개수가 다르면 즉시 경고(6.1: paper/ 실측에서 문장 단위 단일 변형이 전부 무신호였던 검사 단위 불일치를 보완).",
    "negation": {"regex": "지\\s*않|지는\\s*않|지도\\s*않|않는|않았|않다|않을|않고|못하|못했|못한|못해|없다|없었|없는|아니다|아니라|아니었|안\\s*된|안된|지\\s*말", "label": "부정 표현"},
    "hedge": {"regex": "수\\s*있|수도\\s*있|될\\s*수도|할\\s*수도|일\\s*수도|가능성|지도\\s*모|것\\s*같|듯|보인다|보입니다|보이는|추정|기대된|것으로\\s*알려|전해졌|전해진", "label": "가능성·확률 표현"},
    "causal": {"regex": "때문|그래서|따라서|덕분|탓에|므로|로\\s*인해|매개로|무관|불구하고", "label": "인과 표지"},
    "direction": {"regex": "(?<![가-힣])(?:이상(?![하히스])|이하|이전|이후)|부터|까지|초과|미만", "label": "방향·범위 표지"},
    "binary_max_chars": 200,
    "tolerance_ratio": 0.4,
    "tolerance_abs": 2
  }
}
